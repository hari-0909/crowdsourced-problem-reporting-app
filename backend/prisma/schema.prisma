generator client{
  provider="prisma-client-js"
}

datasource db{
  provider="postgresql"
  url=env("DATABASE_URL")
}

model User{
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  role         Role     @default(USER)
  refreshToken String?
  createdAt    DateTime @default(now())
  issues Issue[]
}

model Issue{
  id          String   @id @default(uuid())
  title       String
  description String
  type        String
  latitude    Float
  longitude   Float
  area        String?
  city        String?
  state       String?
  status      Status   @default(REPORTED)
  createdBy   String
  createdAt   DateTime @default(now())
  imageUrl    String?
  user        User     @relation(fields:[createdBy],references:[id])
}

enum Role{
  USER
  ADMIN
}

enum Status{
  REPORTED
  IN_PROGRESS
  RESOLVED
}